# Environment variable template – copy to .env and fill in values
# Never commit .env to version control

# ─── Flask ──────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-very-long-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=3600      # seconds (1 hour)
JWT_REFRESH_TOKEN_EXPIRES=604800   # seconds (7 days)

# Seeded demo account passwords (local development defaults)
SEED_ADMIN_PASSWORD=Admin@1234
SEED_STAFF_PASSWORD=Staff@1234

# ─── Database ───────────────────────────────────────────
DATABASE_URL=sqlite:///subnexa.db

# ─── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (password reset) ─────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@subnexa.ai

# ─── Frontend URL (CORS) ────────────────────────────────
FRONTEND_URL=http://localhost:5173
